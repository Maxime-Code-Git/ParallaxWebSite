{
  "name": "parallax",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Parallax - Studio photo et video",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "start": "HOST=127.0.0.1 npm run start --workspace=apps/web",
    "preview:local": "npm run preview:local --workspace=apps/web",
    "admin:hash": "npm run admin:hash --workspace=apps/web",
    "gallery:setup": "node scripts/gallery-setup.js",
    "smtp:verify": "npm run smtp:verify --workspace=apps/web",
    "legal:apply-drafts": "node scripts/apply-legal-drafts.js",
    "legal:adapt-drafts": "node scripts/adapt-legal-drafts.js",
    "favicons:generate": "node scripts/generate-favicons.js",
    "typography:adapt": "node scripts/adapt-typography.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "content:remediate": "node scripts/remediate-editorial-content.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.12"
  }
}
