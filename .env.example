NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3000

# Configuration administrateur (obligatoire pour acceder a /admin)
# ADMIN_PASSWORD_HASH genere via npm run admin:hash (Argon2id uniquement)
ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET au moins 32 caracteres dedie a la signature du cookie de session
ADMIN_SESSION_SECRET=

# Limitation des tentatives (Rate limiting persistant SQLite)
# RATE_LIMIT_SECRET au moins 32 caracteres dedie au hachage HMAC des cles de requetes
RATE_LIMIT_SECRET=
# RATE_LIMIT_DB_PATH chemin absolu hors du depot, protege en 0700 (dossier) et 0600 (fichier)
# Exemple: /Users/profadmin/Documents/Antigravity/Parallax-data/rate-limit.sqlite
RATE_LIMIT_DB_PATH=
# TRUST_PROXY false par defaut (ignorer les en-tetes proxy). Mettre true uniquement derriere un proxy inverse de confiance.
TRUST_PROXY=false

# --- Variables futures (facultatives pour le Lot 1) ---
# Contenu et stockage
SITE_CONTENT_PATH=
# SITE_MEDIA_PATH chemin absolu hors du depot pour les images uploadees, protege en 0700 (dossier) et 0600 (fichiers)
SITE_MEDIA_PATH=
# Portfolio (Lot 3)
PORTFOLIO_CONTENT_PATH=
PORTFOLIO_MEDIA_PATH=
GALLERY_DB_PATH=
GALLERY_MEDIA_PATH=
GALLERY_IMPORT_PATH=
GALLERY_SECRET=
GALLERY_CODE_ENCRYPTION_KEY=

# Contact et notifications (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
